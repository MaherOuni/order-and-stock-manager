# Copy to .env before running docker compose. The values below are fine for local work;
# every one of them must change for a deployment.
#
#   cp .env.example .env

# --- PostgreSQL --------------------------------------------------------------------------
POSTGRES_DB=orderstock
POSTGRES_USER=orderstock
# Replace this. Anything that reaches the database has full access to every tenant's data.
POSTGRES_PASSWORD=orderstock

# --- API ---------------------------------------------------------------------------------
# Production or Development. Development turns on Swagger and detailed errors.
ASPNETCORE_ENVIRONMENT=Production

# Host port the API is published on: http://localhost:5080/swagger
API_PORT=5080

# Tag used by `docker compose build`/`push`. Point this at your registry to deploy the same
# image to Kubernetes: ghcr.io/OWNER/orderstock-api:1.0.0
API_IMAGE=orderstock-api:local

# Browser origin of the Angular app. The API refuses cross-origin requests from anywhere else,
# so this is the single most common cause of a frontend that loads but cannot fetch anything.
CORS_ORIGIN_0=http://localhost:4200

# --- Schema ------------------------------------------------------------------------------
# Leave both false in production: migrations are applied deliberately (see k8s/migrate-job.yaml
# or `dotnet ef database update`), not by whichever replica boots first.
DATABASE_MIGRATE_ON_STARTUP=false
DATABASE_SEED_DEMO_TENANT=false
