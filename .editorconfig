# Root configuration for the .NET solution. `frontend/.editorconfig` governs the Angular app
# and is left alone.
#
# The point of this file is to make `dotnet format` agree with what is already checked in.
# Without it, format falls back to its Windows defaults, assumes CRLF, and reports every line
# in the repository as a whitespace error — the files are LF, and Git converts on checkout.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

# Namespaces are file-scoped throughout; keep new files that way.
csharp_style_namespace_declarations = file_scoped:warning

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
