{
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoTenant": true
  },
  "Jwt": {
    // Local development only, and it is in source control precisely so it can never be
    // mistaken for a real one. Production supplies Jwt__Key from the environment; the base
    // appsettings leaves it empty so start-up fails loudly rather than signing with this.
    "Key": "dev-only-signing-key-not-for-production-use"
  },
  "Bootstrap": {
    // The first account on a fresh local database, so the admin area can be opened at all.
    // Production sets Bootstrap__Email and Bootstrap__Password from the environment for one
    // run and then removes them.
    "Email": "owner@demo-resto.test",
    "Password": "demo-owner-password",
    "DisplayName": "Demo Owner",
    "Role": "Owner",
    "TenantSlug": "demo-resto"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
