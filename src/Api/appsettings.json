{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=orderstock;Username=orderstock;Password=orderstock"
  },
  "Multitenancy": {
    "HeaderName": "X-Tenant-Id",
    "SlugRoutePrefix": "/api/t",
    "RequireTenant": true
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoTenant": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
